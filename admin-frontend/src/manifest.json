{
  "name": "Avnideep Ayurveda Admin Panel",
  "short_name": "Avnideep Admin",
  "description": "Admin panel for managing orders, analytics, payments, rewards & SEO for Avnideep Ayurveda. Works offline for key features.",
  "start_url": "/dashboard.html",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#0f0f11",
  "theme_color": "#f59e0b",
  "orientation": "portrait-primary",
  "categories": ["business", "productivity", "utilities"],
  "lang": "en",
  "scope": "/",
  "id": "/",
  "edge_side_panel": {
    "preferred_width": 380
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-192x192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View sales dashboard and real-time stats",
      "url": "/dashboard.html",
      "icons": [
        { "src": "/icons/icon-192x192.png", "sizes": "192x192" }
      ]
    },
    {
      "name": "Orders",
      "short_name": "Orders",
      "description": "Manage and track all customer orders",
      "url": "/orders.html",
      "icons": [
        { "src": "/icons/icon-192x192.png", "sizes": "192x192" }
      ]
    },
    {
      "name": "Analytics",
      "short_name": "Analytics",
      "description": "Track performance and revenue insights",
      "url": "/analytics.html",
      "icons": [
        { "src": "/icons/icon-192x192.png", "sizes": "192x192" }
      ]
    },
    {
      "name": "Rewards",
      "short_name": "Rewards",
      "description": "Manage reward wheel entries",
      "url": "/rewards.html",
      "icons": [
        { "src": "/icons/icon-192x192.png", "sizes": "192x192" }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Avnideep Admin Dashboard"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Avnideep Admin Mobile View"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "handle_links": "preferred",
  "note_taking": false
}
